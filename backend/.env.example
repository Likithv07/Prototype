# BhoomiSetu Backend Environment Configuration
# Copy this file to .env and customize values for your local environment

# Application Settings
PROJECT_NAME="BhoomiSetu - Land Acquisition & Management Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="insecure-secret-key-change-in-production-min-32-chars-long"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Origins (Comma-separated list or JSON array of allowed frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration (with PostGIS extension)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="bhoomi_user"
POSTGRES_PASSWORD="bhoomi_secure_password"
POSTGRES_DB="bhoomi_setu_db"

# Asynchronous Database URL (Used by SQLAlchemy asyncpg)
DATABASE_URL="postgresql+asyncpg://bhoomi_user:bhoomi_secure_password@localhost:5432/bhoomi_setu_db"

# Synchronous Database URL (Used by Alembic migrations with psycopg2)
SYNC_DATABASE_URL="postgresql://bhoomi_user:bhoomi_secure_password@localhost:5432/bhoomi_setu_db"

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Configuration (Cache, Celery message broker, SLA tracking)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# Logging Settings
LOG_LEVEL="INFO"
LOG_FORMAT="json"

